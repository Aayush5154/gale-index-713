# Docker Compose defaults. Copy to .env and adjust if needed.
# The application holds no secret keys; Elexon is a public API.

DATA_MODE=live
ENVIRONMENT=docker
LOG_LEVEL=INFO

# Ports on your machine
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Browser origins allowed to call the API directly (comma-separated).
# The Docker frontend is same-origin through nginx and does not need CORS.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Elexon HTTP client bounds
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=45
ELEXON_CONNECT_TIMEOUT_SECONDS=10
ELEXON_MAX_RETRIES=2
ELEXON_CONCURRENCY=4
ELEXON_CHUNK_DAYS=6
ELEXON_FORECAST_LOOKBACK_DAYS=3

# Bounded in-memory cache
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=128
PREWARM_DEFAULT_RANGE=true
