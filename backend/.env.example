# Backend settings. Copy to backend/.env for local development.
# Pydantic reads these case-insensitively.

APP_NAME=Wind Forecast Analytics API
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# live = query Elexon; fixture = serve labelled synthetic January 2026 files.
DATA_MODE=live
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=45
ELEXON_CONNECT_TIMEOUT_SECONDS=10
ELEXON_MAX_RETRIES=2
ELEXON_CONCURRENCY=4
ELEXON_CHUNK_DAYS=6
ELEXON_FORECAST_LOOKBACK_DAYS=3
ELEXON_USER_AGENT=wind-forecast-analytics/1.0 (portfolio analytics)

# Bounded in-memory cache
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=128
PREWARM_DEFAULT_RANGE=true

# Market and analysis defaults
MARKET_TIMEZONE=Europe/London
DEFAULT_FROM_DATE=2026-01-01
DEFAULT_TO_DATE=2026-01-31
DEFAULT_CUTOFF_TIME=09:20
MAX_RANGE_DAYS=92
MAPE_MIN_ACTUAL_MW=1.0
STALE_FORECAST_HOURS=48

# CORS for local Vite development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Fixture directory (default resolves relative to the app package)
# FIXTURE_DIR=fixtures
